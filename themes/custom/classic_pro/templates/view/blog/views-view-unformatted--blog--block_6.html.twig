
      {% for row in rows %}
        {% if loop.index % 4 == 1 %}
          <div class="row gy-5 justify-content-center">
             {{ row.content }}
          {% if loop.last %}  
            </div>
            <hr>
          {% endif %}
        {% else %}
            {{ row.content }}
            {% if loop.last or loop.index % 4 == 0 %}
              </div>
              <hr>
            {% endif %}
        {% endif %}
      {% endfor %}


