    <div class="style-2 owl-carousel owl-theme"> 
        {% for row in rows %}
          {% if loop.index % 4 == 1 %}
            <div class="row">
              {{ row.content }}
          {% if loop.last %}  
            </div>
          {% endif %}
          {% else %}
              {{ row.content }}
              {% if loop.last or loop.index % 4 == 0 %}
              </div>
              {% endif %}
          {% endif %}
        {% endfor %}
    </div>
