{% if  fields.counter.content == '1' or fields.counter.content == '7' or fields.counter.content == '9' or fields.counter.content == '15'%}
    <div class="col-lg-6 col-md-12 col-12 item {{ fields.field_portfolio_category.content }}">
        <div class="item-content lg-size">
                {{ fields.field_image.content }}
            <div class="overlay">
                <div class="overlay-item">
                <a href="{{ fields.field_image_1.content }}" title="Expand Icon"><i class="fas fa-expand"></i></a>
                <h3>{{ fields.title.content }}</h3>
            </div>
         </div>
       </div>
    </div>
{% else %}
    {% if fields.counter.content == '4' or fields.counter.content == '8' or fields.counter.content == '12' or fields.counter.content == '16'%}
        <div class="col-lg-6 col-md-12 col-12 item {{ fields.field_portfolio_category.content }}">
            <div class="item-content sm-size">
                 {{ fields.field_image.content }}
                <div class="overlay">
                    <div class="overlay-item">
                        <a href="{{ fields.field_image_1.content }}" title="Expand Icon"><i class="fas fa-expand"></i></a>
                        <h3>{{ fields.title.content }}</h3>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
         <div class="col-lg-3 col-md-6 col-12 item {{ fields.field_portfolio_category.content }}">
            <div class="item-content sm-size">
                 {{ fields.field_image.content }}
                <div class="overlay">
                    <div class="overlay-item">
                        <a href="{{ fields.field_image_1.content }}" title="Expand Icon"><i class="fas fa-expand"></i></a>
                        <h3>{{ fields.title.content }}</h3>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endif %}