<!-- Single Portfolio -->

{% if  fields.counter.content == '2' or fields.counter.content == '6' or fields.counter.content == '10' or fields.counter.content == '14' %}
 <div class="col-lg-4 col-sm-6 col-12 item {{ fields.field_portfolio_category.content }}">
    <div class="item-content h-large">
        {{ fields.field_image.content }}
        <div class="overlay">
            <div class="overlay-item">
                <a href="{{ fields.field_image_1.content }}" title="Expand Icon"><i class="fas fa-expand"></i></a>
                <h3>{{ fields.title.content }}</h3>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="col-lg-4 col-sm-6 col-12 item {{ fields.field_portfolio_category.content }}">
    <div class="item-content">
        {{ fields.field_image.content }}
        <div class="overlay">
            <div class="overlay-item">
                <a href="{{ fields.field_image_1.content }}" title="Expand Icon"><i class="fas fa-expand"></i></a>
                <h3>{{ fields.title.content }}</h3>
            </div>
        </div>
    </div>
</div>
{% endif %}  