<!-- Team Member -->
<div class="col-lg-4 col-md-6 col-12 aos-init aos-animate" data-aos="fade-up" data-aos-duration="800">
    <div class="item">
        <div class="image">
            {{ fields.field_image.content }}
            {{ fields.field_social_links.content }}
        </div>
        <div class="item-content">
            <h3>{{ fields.field_name.content }}</h3>
            <h4>{{ fields.field_designation.content }}</h4>
        </div>
    </div>
</div>