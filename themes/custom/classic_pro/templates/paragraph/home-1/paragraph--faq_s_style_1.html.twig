<!-- FAQ -->
 <section class="faq-1 accordion-style-1 section">
        <div class="container">
            <div class="home-1-title aos-init aos-animate" data-aos="fade-in" data-aos-duration="1000">
                <h2>{{ content.field_title.0}}</h2>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 col-12">
                    <div class="image aos-init aos-animate" data-aos="zoom-in" data-aos-duration="800">
                        <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}" alt="{{content.field_image['#items'].alt}}">
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-12 aos-init aos-animate" data-aos="fade-up" data-aos-duration="800">
                {{ content.field_faq}}  
                </div>
            </div>
        </div>
    </section>
    

