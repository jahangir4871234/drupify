 <div class="item progress-bar-style-4 wow fadeInRight" data-wow-duration=".80s" data-wow-delay="0s" style="visibility: visible; animation-duration: 0.8s; animation-delay: 0s; animation-name: fadeInRight;">
    <div class="progress-details"><h5>{{ content.field_title.0 }}</h5><h5>{{ content.field_percentage_value.0 }}%</h5></div>
