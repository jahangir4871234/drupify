<!-- Team -->  
{% if 'On' in content.field_background_style.0 %}
  <section class="our-team-3 carousels-style-3 team-style-2 section aos-init aos-animate" data-aos="fade-up" data-aos-duration="800">
        <div class="container">
            <div class="home-3-title aos-init aos-animate" data-aos="fade-out" data-aos-duration="1000">
                <span>{{ content.field_tag_line.0 }}</span>
                <h2>{{ content.field_section_title.0 }}</h2>
            </div>
            {{ content.field_team_member_ }}
        </div>
    </section>
{% else %}
    <section class="carousels-style-3 team-style-2 section aos-init aos-animate" data-aos="fade-up" data-aos-duration="800">
        <div class="container">
            <div class="pages-title aos-init aos-animate" data-aos="fade-out" data-aos-duration="1000">
                <span>{{ content.field_tag_line.0 }}</span>
                <h2>{{ content.field_section_title.0 }}</h2>
            </div>
            {{ content.field_team_member_ }}
        </div>
    </section>
{% endif %}