<!-- Slider -->
<section class="home-banner-3">
        <div class="banner-bg">
            <svg xmlns="http://www.w3.org/2000/svg" width="826" height="423.6" viewBox="0 0 826 423.6">
                <path id="Home-Top-BG" d="M73.18,422.59C113.4,331.49,168.35,224,275.56,183c126.35-48.24,266.24,6.75,396.87-21.7,63.5-13.83,128.21-40.23,174.25-82.8a335.185,335.185,0,0,0,36.41-40.19h-826v423.6Q64.6,442.07,73.18,422.59Z" transform="translate(-57.09 -38.31)"/>
            </svg>
        </div>
        <div class="container-fluid p-0">
            <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    {{ content.field_slide_style_3 }}
                </div>
                <div class="arrows">
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                        <span class="icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="59.461" height="41" viewBox="0 0 59.461 41">
                                <path data-name="Icon ionic-ios-arrow-round-forward" d="M29.054,12.018a2.772,2.772,0,0,1,.02,3.833L16.728,28.537H63.717a2.71,2.71,0,0,1,0,5.416H16.749L29.095,46.64a2.793,2.793,0,0,1-.02,3.833,2.582,2.582,0,0,1-3.716-.021L8.626,33.162h0a3.049,3.049,0,0,1-.548-.854,2.643,2.643,0,0,1-.2-1.042,2.752,2.752,0,0,1,.751-1.9L25.359,12.08A2.541,2.541,0,0,1,29.054,12.018Z" transform="translate(-7.375 -10.752)" fill="#fff" stroke="#fff" stroke-width="1"/>
                            </svg>
                        </span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                        <span class="icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="59.461" height="41" viewBox="0 0 59.461 41">
                                <path data-name="Icon ionic-ios-arrow-round-forward" d="M45.157,12.018a2.772,2.772,0,0,0-.02,3.833L57.483,28.537H10.494a2.71,2.71,0,0,0,0,5.416H57.463L45.117,46.64a2.793,2.793,0,0,0,.02,3.833,2.582,2.582,0,0,0,3.716-.021l16.732-17.29h0a3.049,3.049,0,0,0,.548-.854,2.643,2.643,0,0,0,.2-1.042,2.752,2.752,0,0,0-.751-1.9L48.853,12.08A2.541,2.541,0,0,0,45.157,12.018Z" transform="translate(-7.375 -10.752)" fill="#fff" stroke="#fff" stroke-width="1"/>
                            </svg>
                        </span>
                    </button>
                </div>
            </div>
        </div>
        <div class="icons-list">
            <div class="icons-left">
                {% for key,value in content.field_banner_left_icons['#items'] %}
                    <img src="{{ file_url(content.field_banner_left_icons['#items'][key].entity.uri.value) }}" alt="{{content.field_banner_left_icons['#items'][key].alt}}">
                {% endfor %}
            </div>
            <div class="icons-right">
                {% for key,value in content.field_banner_right_icons['#items'] %}
                    <img src="{{ file_url(content.field_banner_right_icons['#items'][key].entity.uri.value) }}" alt="{{content.field_banner_right_icons['#items'][key].alt}}">
                {% endfor %}
            </div>
        </div>
    </section>


